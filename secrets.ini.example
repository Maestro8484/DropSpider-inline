; Copy this file to secrets.ini (same folder) and fill in your own values.
; secrets.ini is listed in .gitignore, so your passwords never go into git.
; No quotes around the values.
;
; The board joins this network by DHCP (the router hands it an address).
; If it cannot join within 15 s it makes its own network, DropSpider-setup,
; and the page is then at 192.168.4.1.

[secrets]
wifi_ssid = YourNetworkName
wifi_pass = YourNetworkPassword
; password for firmware updates over the network (both the PlatformIO ota
; upload and the Update card on the web page, user name admin)
ota_pass = dropspider
